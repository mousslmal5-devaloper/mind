<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mind_water_widget_title"
        android:textColor="#A2A2AB"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/water_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 / 8"
        android:textColor="#F4F4F6"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/water_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#5AA9FF"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/water_remove"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_background"
            android:gravity="center"
            android:text="−"
            android:textColor="#F4F4F6"
            android:textSize="24sp" />
        <TextView
            android:id="@+id/water_add"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_background"
            android:gravity="center"
            android:text="+"
            android:textColor="#E8C547"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
